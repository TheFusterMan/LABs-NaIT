// --- Переменные ---
mainColor = #333
accentColor = #4CAF50
lightBg = #f9f9f9
borderColor = #ddd
gapSize = 20px
linkColor = saddlebrown

// --- Общие стили ---
body
  font-family 'Arial', sans-serif
  color mainColor
  margin 0
  padding 0

.container
  width 90%
  margin 0 auto
  padding 20px

// --- Меню ---
.menu
  margin-top 5px
  width 100%
  border-top-style double
  border-bottom-style double
  border-color borderColor
  background-color bgColor

  &__list
    display flex
    flex-direction row
    justify-content center
    list-style-type none
    margin 0
    padding 0
    @media (max-width: 1000px)
      flex-wrap wrap

  &__item
    padding 1%
    @media (max-width: 1000px)
      width 45%
      text-align center
    &--active .menu__link
      color accentColor
      font-weight bold
    &--active
      border-left-style double
      border-right-style double
      @media (max-width: 1000px)
        border-style none

  &__link
    text-decoration none
    color mainColor
    text-transform uppercase
    font-size 1.25em
    &:hover
      color accentColor

// --- Галерея (Grid Mosaic) ---
// Повторяем сложную сетку из скриншота
.gallery-grid
  display grid
  grid-template-columns 1fr 1fr 1fr
  grid-template-rows 200px 200px 200px
  padding 20px
  max-width 1200px
  margin 0 auto

  &__item
    overflow hidden
    img
      width 100%
      height 100%
      object-fit cover

    &--wide
      grid-column 2 / 4
      grid-row 1 / 3

    &--long
      grid-column 1 / 3
      grid-row 3 / 3

// --- СТАТЬИ ---
.main-layout
  display grid
  grid-template-columns 20% 1fr 20% // Левая, Центр, Правая
  gap gapSize
  padding 20px
  max-width 1400px
  margin 0 auto

  @media (max-width: 900px)
    grid-template-columns 1fr

  &__col
    display flex
    flex-direction column
    gap gapSize

    &--left
      border-right 1px solid borderColor
      padding-right 10px

    &--right
      border-left 1px solid borderColor
      padding-left 10px

// --- Карточки (БЭМ) ---
.card
  display flex
  justify-content space-between
  word-wrap break-word

  &__content
  &__text-block
    width 45%
    @media (max-width: 1000px)
      width 100%
      text-align center

  &__image-box
    width 45%
    height 100%

  &__img
    object-fit cover
    width 100%
    height 100%

  &__title
    text-align center

  &__text
    text-align justify

  &__link
    color linkColor
    text-decoration underline
    cursor pointer
    &:hover
      color accentColor

// --- Центральный блок ---
.central-block
  display flex
  justify-content space-between
  word-wrap break-word
  flex-wrap wrap

  &__title
    width 100%
    text-align center

  &__body
    display grid
    grid-template-columns 1fr 1fr
    gap 15px
    @media (max-width: 600px)
      grid-template-columns 1fr

  &__text
    display flex
    gap 5%
    flex-wrap wrap
    text-align justify

  &__text p
    width 45%

  &__img img
    width 100%

  &--bottom
    text-align center

  &--bottom p
    text-align justify
    width 100%
    
// --- Стили для таблицы и формы ---

.data-table
  width 100%
  border-collapse collapse
  th, td
    border 1px solid borderColor
    padding 8px
    text-align left
  th
    background-color #eee

// --- Футер ---
.footer
  text-align center
  padding 20px
  background #333
  color #fff
  margin-top 20px