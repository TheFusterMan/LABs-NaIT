extends template.pug

block nav
    +createMenu(dictMenu, 'Главная')

block content
    main.container
        h1= bearPage.title
        section.detail-view
            img.detail-view__img(src= require("../images/" + bearPage.img) alt= bearPage.title)
            div.detail-view__info
                each paragraph in bearPage.text
                    p= paragraph
                a.card__link(href="index.html") Вернуться назад