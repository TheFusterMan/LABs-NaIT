back(size)
  background-color #f1f1f1
  box-shadow 4px 5px 10px rgba(0, 0, 0, 0.4)
  padding size + "%"
  margin 0 0 1% 0

colorText = #6f6d6d

html
  color colorText

nav
  back(0)
  text-align right

  & a
    display inline-block
    padding 1%
    color colorText
    text-decoration none

    &:hover
    &.active
      background-color #f87777
      color #f8f8f8

div.images
  display grid
  grid-template-columns repeat(5, 1fr)
  grid-gap 0.5%
  back(1)

  & img
    width 100%

article
  width 80%
  margin auto
  display grid
  grid-template-columns repeat(3, 1fr)
  grid-gap 4%

  & section
    display grid
    grid-template-columns 1fr 2fr
    align-items center
    grid-gap 2%
    back(2)

    & h3
      grid-column 1/3
      margin 0
      text-align center

    & img
      width: 100%
      height: 100%

footer
  background-color colorText
  & h4
    padding 5px
    color #f8f8f8
    margin 0
    text-align left

// задание 3.3

img.big
  display block
  margin 0 auto
  width 35%

section
  margin 0 auto
  margin-bottom 20px
  display grid
  grid-template-columns 1fr 1fr
  grid-gap 30px

@media (max-width: 650px)
  //задание 3.4
  body
    width 98%

    & img.big
      margin-top 10px
      width 80%

    & section
      grid-template-columns 1fr
      grid-gap 0

    & p
      margin-bottom 0

  & div.images
    grid-template-columns 1fr
    grid-gap 15px
    width 98%
    margin-bottom 30px

    & img
      display block
      width 78%
      height auto
      margin 0 auto

  // задание 2
  article
    width 100%
    grid-template-columns 1fr
    grid-gap 20px

    & section
      width 98%
      margin 0 auto
      padding 0
      grid-template-columns 0.3fr 0.7fr
      grid-gap 30px

      & img
        width 100%
        padding-bottom 10px
        padding-left 10px